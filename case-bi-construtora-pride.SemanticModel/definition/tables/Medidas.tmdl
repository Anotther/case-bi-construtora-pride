/// Tabela técnica dedicada às medidas DAX do modelo, incluindo vendas, metas, atingimento, ticket médio, cobertura de metas, comparação com o ano anterior, média histórica e receita de clientes não identificados.
table Medidas
	lineageTag: a3c9367b-1ed0-424c-a59c-47775b6f5991

	/// Soma o valor de todas as vendas no contexto de filtro atual.
	measure 'Total Vendas' = SUM(fVendas[VALOR_VENDA])
		formatString: R$ #,##0
		displayFolder: Vendas
		lineageTag: e1a03b40-40a5-4d32-8f8c-fd5442ade721

	/// Soma o valor de meta para as combinações produto, região e trimestre visíveis.
	measure 'Total Meta' = SUM(dMetas[META_VENDAS])
		formatString: R$ #,##0
		displayFolder: Metas
		lineageTag: 241ed13f-3bad-46b0-81bb-e837c6a0e1ba

	/// Percentual de atingimento da meta; retorna vazio quando não há meta definida.
	measure '% Atingimento' = DIVIDE([Total Vendas], [Total Meta])
		formatString: 0.00%
		displayFolder: Metas
		lineageTag: d79193a0-b285-4459-bb1a-e812f91d6aed

	/// Contagem de transações de venda no contexto atual.
	measure 'Qtd Vendas' = COUNTROWS(fVendas)
		formatString: #,##0
		displayFolder: Vendas
		lineageTag: ea1a7d30-a6db-4756-b41d-4691b9670767

	/// Valor médio por transação de venda.
	measure 'Ticket Médio' = AVERAGE(fVendas[VALOR_VENDA])
		formatString: R$ #,##0.00
		displayFolder: Vendas
		lineageTag: 2549770c-cc51-40eb-8b85-53cad2fb2c10

	/// Percentual das 50 combinações possíveis de produto e região com meta definida.
	measure 'Cobertura de Metas' = DIVIDE(COUNTROWS(dMetas), 50)
		formatString: 0.00%
		displayFolder: Metas
		lineageTag: 7dc8b176-74c7-4287-8181-0e50c6c651f2

	/// Vendas no mesmo período do ano anterior.
	measure 'Vendas LY' = CALCULATE([Total Vendas], DATEADD(dCalendario[Data], -1, YEAR))
		formatString: R$ #,##0
		displayFolder: Inteligência de Tempo
		lineageTag: e57b3926-ff43-4a47-84cb-9a98e4b4e299

	/// Média histórica trimestral, considerando 16 trimestres completos entre 2023 e 2026.
	measure 'Média Trimestral Hist' = DIVIDE(CALCULATE([Total Vendas], ALL(dCalendario)), 16)
		formatString: R$ #,##0.00
		displayFolder: Inteligência de Tempo
		lineageTag: 68b58125-50c0-47cf-b8d6-142c59885721

	/// Compara as vendas do período atual com a média histórica trimestral.
	measure '% vs Média Hist' = DIVIDE([Total Vendas], [Média Trimestral Hist])
		formatString: 0.00%
		displayFolder: Inteligência de Tempo
		lineageTag: d68b9752-a50b-43cf-afa2-12402c5ad762

	/// Percentual da receita associada a clientes sem cadastro identificado.
	measure '% Receita Não Identificada' = DIVIDE(CALCULATE([Total Vendas], dClientes[TIPO_CADASTRO] = "Não identificado"), [Total Vendas])
		formatString: 0.00%
		displayFolder: Qualidade de Dados
		lineageTag: 37f8cd95-e35e-462e-acf6-e1bf87cb4a89

	/// Variação absoluta das vendas em relação ao mesmo período do ano anterior.
	measure 'Variação vs LY' = [Total Vendas] - [Vendas LY]
		formatString: R$ #,##0;[Red]-R$ #,##0
		displayFolder: Inteligência de Tempo
		lineageTag: 6b1c9d70-c66a-4baa-8185-905b13ec17ba

	/// Variação percentual das vendas em relação ao mesmo período do ano anterior.
	measure '% Variação vs LY' = DIVIDE([Total Vendas] - [Vendas LY], [Vendas LY])
		formatString: 0.00%;[Red]-0.00%
		displayFolder: Inteligência de Tempo
		lineageTag: 98775333-3951-4c2c-b5dc-33827bc6e154

	/// Participação da receita do contexto atual sobre a receita total sem filtros da tabela de vendas.
	measure '% Receita' = DIVIDE([Total Vendas], CALCULATE([Total Vendas], ALL(fVendas)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Participação
		lineageTag: c84f0baa-430e-4305-b2ff-964c58e94d8d

	/// Valor de vendas ainda necessário para atingir a meta no contexto atual; valores negativos indicam superação.
	measure 'Gap Meta R$' = [Total Meta] - [Total Vendas]
		formatString: R$ #,##0;[Red]-R$ #,##0
		displayFolder: Metas
		lineageTag: fe0ea5f9-3b40-49bb-bdc7-a1f987acffc5

	/// Percentual da meta ainda não atingido; valores negativos indicam superação da meta.
	measure '% Gap Meta' = DIVIDE([Gap Meta R$], [Total Meta])
		formatString: 0.00%;[Red]-0.00%
		displayFolder: Metas
		lineageTag: 9c7af530-eaf2-4291-a6e4-4f65713181bd

	/// Valor absoluto da receita associada a clientes sem cadastro identificado.
	measure 'Receita Não Identificada R$' = CALCULATE([Total Vendas], dClientes[TIPO_CADASTRO] = "Não identificado")
		formatString: R$ #,##0
		displayFolder: Qualidade de Dados
		lineageTag: fdb52d72-b23b-4dc0-99da-3948ba57dbd4

	/// Posição do produto por receita total no contexto selecionado, com empates usando ranking denso.
	measure 'Rank Produto' = RANKX(ALL(fVendas[ID_PRODUTO]), [Total Vendas], , DESC, DENSE)
		formatString: 0
		displayFolder: Rankings
		lineageTag: 20026ba4-869b-425c-80f1-57105bb4f3b9

	/// Posição da região por receita total no contexto selecionado, com empates usando ranking denso.
	measure 'Rank Região' = RANKX(ALL(fVendas[REGIÃO]), [Total Vendas], , DESC, DENSE)
		formatString: 0
		displayFolder: Rankings
		lineageTag: be835fde-1c35-4d10-a080-78ecbc2b2cce

	/// Nome do canal com maior receita no contexto atual, desconsiderando membros vazios.
	measure 'Canal Líder' =
			VAR resumo =
			  FILTER(
			    ADDCOLUMNS(
			      ALL(fVendas[CANAL_VENDA]),
			      "@Total", CALCULATE([Total Vendas])
			    ),
			    NOT ISBLANK(fVendas[CANAL_VENDA]) && NOT ISBLANK([@Total])
			  )
			RETURN
			  MAXX(
			    TOPN(1, resumo, [@Total], DESC, fVendas[CANAL_VENDA], ASC),
			    fVendas[CANAL_VENDA]
			  )
		displayFolder: Destaques
		lineageTag: 561a613c-92b4-47e6-9230-4aa7e32bc051

	/// Participação percentual na receita do canal líder.
	measure '% Receita Canal Líder' =
			VAR canal = [Canal Líder]
			RETURN CALCULATE([% Receita], fVendas[CANAL_VENDA] = canal)
		formatString: 0.00%
		displayFolder: Destaques
		lineageTag: f27edf92-f208-4e63-9dbe-55fa1c0ba248

	/// Nome da região com maior receita no contexto atual, desconsiderando membros vazios.
	measure 'Região Líder' =
			VAR resumo =
			  FILTER(
			    ADDCOLUMNS(
			      ALL(fVendas[REGIÃO]),
			      "@Total", CALCULATE([Total Vendas])
			    ),
			    NOT ISBLANK(fVendas[REGIÃO]) && NOT ISBLANK([@Total])
			  )
			RETURN
			  MAXX(
			    TOPN(1, resumo, [@Total], DESC, fVendas[REGIÃO], ASC),
			    fVendas[REGIÃO]
			  )
		displayFolder: Destaques
		lineageTag: 55bbce56-ecc0-4f1a-a0bd-6940d343ca4d

	/// Participação percentual na receita da região líder.
	measure '% Receita Região Líder' =
			VAR reg = [Região Líder]
			RETURN CALCULATE([% Receita], fVendas[REGIÃO] = reg)
		formatString: 0.00%
		displayFolder: Destaques
		lineageTag: a89a729b-a91f-4cc8-8b5e-46563e42fbd3

	/// Nome da região com menor receita no contexto atual, desconsiderando membros vazios.
	measure 'Região Atenção' =
			VAR resumo =
			  FILTER(
			    ADDCOLUMNS(
			      ALL(fVendas[REGIÃO]),
			      "@Total", CALCULATE([Total Vendas])
			    ),
			    NOT ISBLANK(fVendas[REGIÃO]) && NOT ISBLANK([@Total])
			  )
			RETURN
			  MAXX(
			    TOPN(1, resumo, [@Total], ASC, fVendas[REGIÃO], ASC),
			    fVendas[REGIÃO]
			  )
		displayFolder: Destaques
		lineageTag: 325144a3-6305-41cb-bfad-040fbecb30a8

	/// Participação percentual na receita da região com menor desempenho.
	measure '% Receita Região Atenção' =
			VAR reg = [Região Atenção]
			RETURN CALCULATE([% Receita], fVendas[REGIÃO] = reg)
		formatString: 0.00%
		displayFolder: Destaques
		lineageTag: 5c5cdc56-42c8-4f5f-bd3d-05520c98f93d

	/// Receita total da região líder no contexto atual.
	measure 'Total Vendas Região Líder' =
			VAR reg = [Região Líder]
			RETURN CALCULATE([Total Vendas], fVendas[REGIÃO] = reg)
		formatString: R$ #,##0
		displayFolder: Destaques
		lineageTag: 493dcd62-8072-4070-9754-770e0e5532df

	/// Receita total da região com menor desempenho no contexto atual.
	measure 'Total Vendas Região Atenção' =
			VAR reg = [Região Atenção]
			RETURN CALCULATE([Total Vendas], fVendas[REGIÃO] = reg)
		formatString: R$ #,##0
		displayFolder: Destaques
		lineageTag: 66d39484-0a06-4b50-a663-e941cd9f2bd6

	/// Receita total do canal líder no contexto atual.
	measure 'Total Vendas Canal Líder' =
			VAR canal = [Canal Líder]
			RETURN CALCULATE([Total Vendas], fVendas[CANAL_VENDA] = canal)
		formatString: R$ #,##0
		displayFolder: Destaques
		lineageTag: 9e87e766-b0c5-4af8-98f0-b0847abba135

	/// Quantidade de transações da região com menor desempenho no contexto atual.
	measure 'Qtd Vendas Região Atenção' =
			VAR reg = [Região Atenção]
			RETURN CALCULATE([Qtd Vendas], fVendas[REGIÃO] = reg)
		formatString: #,##0
		displayFolder: Destaques
		lineageTag: ffeaa6a2-87ac-491c-aa7a-707747a26f76

	measure 'Média Hist - Label Final' =
			IF(
				MAX(dCalendario[AnoTri]) = CALCULATE(MAX(dCalendario[AnoTri]), ALLSELECTED(dCalendario[AnoTri])),
				[Média Trimestral Hist],
				BLANK()
			)
		formatString: R$ #,##0
		displayFolder: Inteligência de Tempo
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890

	/// Fileira executiva de KPIs de performance renderizada pelo visual HTML Content.
	measure 'HTML Cards Executivos' =
			VAR TotalVendas = IFERROR(IF(ISBLANK([Total Vendas]), "&mdash;", FORMAT([Total Vendas], "R$ #,##0")), "&mdash;")
			VAR QtdVendas = IFERROR(IF(ISBLANK([Qtd Vendas]), "Sem transações no período", FORMAT([Qtd Vendas], "#,##0") & " transações no período"), "Sem transações no período")
			VAR TicketMedio = IFERROR(IF(ISBLANK([Ticket Médio]), "&mdash;", FORMAT([Ticket Médio], "R$ #,##0")), "&mdash;")
			VAR VariacaoPct = IFERROR(IF(ISBLANK([% Variação vs LY]), "&mdash;", FORMAT([% Variação vs LY], "0.0%;-0.0%;0.0%")), "&mdash;")
			VAR VariacaoValor = IFERROR(IF(ISBLANK([Variação vs LY]), "Sem base comparável", FORMAT([Variação vs LY], "+R$ #,##0;-R$ #,##0;R$ 0") & " vs. ano anterior"), "Sem base comparável")
			VAR CorVariacao = IFERROR(SWITCH(TRUE(), ISBLANK([% Variação vs LY]), "#6E5746", [% Variação vs LY] >= 0, "#6B797D", "#4D332C"), "#6E5746")
			VAR Canal = IFERROR(IF(ISBLANK([Canal Líder]), "&mdash;", [Canal Líder]), "&mdash;")
			VAR CanalPct = IFERROR(IF(ISBLANK([% Receita Canal Líder]), "Sem participação calculada", FORMAT([% Receita Canal Líder], "0%") & " da receita selecionada"), "Sem participação calculada")
			RETURN
				"<style>"
				& "*{box-sizing:border-box}#htmlContent,.htmlViewerEntry{width:100%;height:100%;margin:0;padding:0;overflow:hidden}"
				& ".kpi-layout{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;width:100%;height:100%;padding:3px 2px 7px;font-family:'Segoe UI',Arial,sans-serif;color:#24212E}"
				& ".kpi{position:relative;min-width:0;height:100%;padding:18px 18px 15px;background:#FFFFFF;border:1px solid #EDE8E1;border-radius:16px;box-shadow:0 2px 4px rgba(36,33,46,.06),0 10px 28px rgba(36,33,46,.09);overflow:hidden}"
				& ".kpi:before{content:'';position:absolute;top:0;left:0;right:0;height:5px;background:#B08D72}"
				& ".label{display:block;margin:1px 0 7px;color:#6E5746;font-size:10px;line-height:1;text-transform:uppercase;letter-spacing:1px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
				& ".value{display:block;color:#24212E;font-size:25px;line-height:1.08;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
				& ".detail{display:block;margin-top:8px;color:#6E5746;font-size:11px;line-height:1.25;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
				& ".positive{color:#6B797D}.attention{color:#4D332C}"
				& "</style>"
				& "<section class='kpi-layout'>"
				& "<article class='kpi'><span class='label'>VENDAS TOTAIS</span><strong class='value'>" & TotalVendas & "</strong><span class='detail'>" & QtdVendas & "</span></article>"
				& "<article class='kpi'><span class='label'>TICKET MÉDIO</span><strong class='value'>" & TicketMedio & "</strong><span class='detail'>valor médio por transação</span></article>"
				& "<article class='kpi'><span class='label'>VARIAÇÃO ANUAL</span><strong class='value' style='color:" & CorVariacao & "'>" & VariacaoPct & "</strong><span class='detail' style='color:" & CorVariacao & "'>" & VariacaoValor & "</span></article>"
				& "<article class='kpi'><span class='label'>CANAL LÍDER</span><strong class='value'>" & Canal & "</strong><span class='detail positive'>" & CanalPct & "</span></article>"
				& "</section>"
		displayFolder: Destaques
		lineageTag: d2815ae5-48d3-4bc2-ac6a-2f6bb1a68ed7

	/// Cards geográficos de região líder e região de atenção, renderizados pelo visual HTML Content.
	measure 'HTML Cards Regioes' =
			VAR RegiaoLider = IFERROR(IF(ISBLANK([Região Líder]), "&mdash;", [Região Líder]), "&mdash;")
			VAR RegiaoLiderPct = IFERROR(IF(ISBLANK([% Receita Região Líder]), "N/D com filtro ativo", FORMAT([% Receita Região Líder], "0%") & " da receita selecionada"), "N/D com filtro ativo")
			VAR RegiaoAtencao = IFERROR(IF(ISBLANK([Região Atenção]), "&mdash;", [Região Atenção]), "&mdash;")
			VAR RegiaoAtencaoPct = IFERROR(IF(ISBLANK([% Receita Região Atenção]), "N/D com filtro ativo", FORMAT([% Receita Região Atenção], "0%") & " da receita selecionada"), "N/D com filtro ativo")
			RETURN
				"<style>"
				& "*{box-sizing:border-box}#htmlContent,.htmlViewerEntry{width:100%;height:100%;margin:0;padding:0;overflow:hidden}"
				& ".kpi-layout{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;width:100%;height:100%;padding:3px 2px 7px;font-family:'Segoe UI',Arial,sans-serif;color:#24212E}"
				& ".kpi{position:relative;min-width:0;height:100%;padding:18px 18px 15px;background:#FFFFFF;border:1px solid #EDE8E1;border-radius:16px;box-shadow:0 2px 4px rgba(36,33,46,.06),0 10px 28px rgba(36,33,46,.09);overflow:hidden}"
				& ".kpi:before{content:'';position:absolute;top:0;left:0;right:0;height:5px;background:#566164}"
				& ".label{display:block;margin:1px 0 7px;color:#6E5746;font-size:10px;line-height:1;text-transform:uppercase;letter-spacing:1px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
				& ".value{display:block;color:#24212E;font-size:25px;line-height:1.08;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
				& ".detail{display:block;margin-top:8px;color:#6E5746;font-size:11px;line-height:1.25;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
				& ".positive{color:#6B797D}.attention{color:#4D332C}"
				& "</style>"
				& "<section class='kpi-layout'>"
				& "<article class='kpi'><span class='label'>REGIÃO LÍDER</span><strong class='value'>" & RegiaoLider & "</strong><span class='detail positive'>" & RegiaoLiderPct & "</span></article>"
				& "<article class='kpi'><span class='label'>REGIÃO DE ATENÇÃO</span><strong class='value'>" & RegiaoAtencao & "</strong><span class='detail attention'>" & RegiaoAtencaoPct & "</span></article>"
				& "</section>"
		displayFolder: Destaques
		lineageTag: e3f4a5b6-c7d8-9012-efab-cd1234567890

	/// Tabela HTML dinamica de receita por produto e regiao, com participacao da regiao no total de cada produto.
	measure 'HTML Vendas Produto Regiao' =
			VAR RegioesVisiveis =
				FILTER(
					CALCULATETABLE(
						VALUES(fVendas[REGIÃO]),
						ALLSELECTED(fVendas[REGIÃO])
					),
					NOT ISBLANK(fVendas[REGIÃO])
				)
			VAR ProdutosVisiveis =
				FILTER(
					CALCULATETABLE(
						VALUES(fVendas[ID_PRODUTO]),
						ALLSELECTED(fVendas[ID_PRODUTO])
					),
					NOT ISBLANK(fVendas[ID_PRODUTO])
				)
			VAR ProdutosComTotal =
				ADDCOLUMNS(
					ProdutosVisiveis,
					"@TotalProduto",
						VAR ProdutoAtual = fVendas[ID_PRODUTO]
						RETURN
							CALCULATE(
								[Total Vendas],
								TREATAS({ ProdutoAtual }, fVendas[ID_PRODUTO]),
								REMOVEFILTERS(fVendas[REGIÃO]),
								TREATAS(RegioesVisiveis, fVendas[REGIÃO])
							)
				)
			VAR QtdRegioes = COUNTROWS(RegioesVisiveis)
			VAR TotalGeral =
				CALCULATE(
					[Total Vendas],
					REMOVEFILTERS(fVendas[REGIÃO]),
					TREATAS(RegioesVisiveis, fVendas[REGIÃO]),
					TREATAS(ProdutosVisiveis, fVendas[ID_PRODUTO])
				)
			VAR ColunasGrid =
				"minmax(118px,1.25fr) repeat(" & QtdRegioes
				& ",minmax(112px,1fr)) minmax(122px,1.1fr)"
			VAR CabecalhoRegioes =
				CONCATENATEX(
					RegioesVisiveis,
					"<div class='head-cell region'>" & fVendas[REGIÃO] & "</div>",
					"",
					fVendas[REGIÃO],
					ASC
				)
			VAR LinhasProdutos =
				CONCATENATEX(
					ProdutosComTotal,
					VAR ProdutoAtual = fVendas[ID_PRODUTO]
					VAR TotalProduto = [@TotalProduto]
					VAR CelulasRegiao =
						CONCATENATEX(
							RegioesVisiveis,
							VAR RegiaoAtual = fVendas[REGIÃO]
							VAR VendasCelula =
								CALCULATE(
									[Total Vendas],
									TREATAS({ ProdutoAtual }, fVendas[ID_PRODUTO]),
									TREATAS({ RegiaoAtual }, fVendas[REGIÃO])
								)
							VAR ParticipacaoProduto = DIVIDE(VendasCelula, TotalProduto)
							VAR FundoCelula =
								SWITCH(
									TRUE(),
									ISBLANK(VendasCelula), "#FFFFFF",
									ParticipacaoProduto >= 0.35, "#E8DFD4",
									ParticipacaoProduto >= 0.20, "#F2ECE5",
									"#FCF7F0"
								)
							RETURN
								"<div class='data-cell' style='background:" & FundoCelula & ";'>"
								& "<span class='money'>" & IF(ISBLANK(VendasCelula), "&mdash;", FORMAT(VendasCelula, "R$ #,##0")) & "</span>"
								& "<span class='share'>" & FORMAT(COALESCE(ParticipacaoProduto, 0), "0.0%") & "</span>"
								& "</div>",
							"",
							fVendas[REGIÃO],
							ASC
						)
					RETURN
						"<div class='matrix-row' style='grid-template-columns:" & ColunasGrid & ";'>"
						& "<div class='product-cell'><strong>P" & ProdutoAtual & "</strong><span>Produto</span></div>"
						& CelulasRegiao
						& "<div class='data-cell total-cell'><span class='money'>" & FORMAT(TotalProduto, "R$ #,##0") & "</span><span class='share'>100.0%</span></div>"
						& "</div>",
					"",
					[@TotalProduto],
					DESC,
					fVendas[ID_PRODUTO],
					ASC
				)
			VAR TotaisRegiao =
				CONCATENATEX(
					RegioesVisiveis,
					VAR RegiaoAtual = fVendas[REGIÃO]
					VAR VendasRegiao =
						CALCULATE(
							[Total Vendas],
							TREATAS({ RegiaoAtual }, fVendas[REGIÃO]),
							TREATAS(ProdutosVisiveis, fVendas[ID_PRODUTO])
						)
					VAR ParticipacaoGeral = DIVIDE(VendasRegiao, TotalGeral)
					RETURN
						"<div class='data-cell grand-cell'><span class='money'>" & FORMAT(VendasRegiao, "R$ #,##0") & "</span>"
						& "<span class='share'>" & FORMAT(ParticipacaoGeral, "0.0%") & "</span></div>",
					"",
					fVendas[REGIÃO],
					ASC
				)
			RETURN
				"<style>"
				& "*{box-sizing:border-box}#htmlContent,.htmlViewerEntry{width:100%;height:100%;margin:0;padding:0;overflow:hidden}"
				& ".matrix-shell{height:100%;overflow:hidden;background:#fff;border:1px solid #EDE8E1;border-radius:14px;font-family:'Segoe UI',Arial,sans-serif;color:#24212E}"
				& ".matrix-title{display:flex;align-items:baseline;gap:10px;padding:10px 18px 9px;border-bottom:1px solid #EDE8E1}.matrix-title h2{margin:0;font-size:15px;font-weight:700;line-height:1.1;white-space:nowrap}.matrix-title p{margin:0;color:#6E5746;font-size:10px;letter-spacing:.02em}"
				& ".matrix-header,.matrix-row{display:grid;grid-template-columns:" & ColunasGrid & ";min-width:max-content}"
				& ".matrix-header{position:sticky;top:0;z-index:2;background:#566164;color:#fff}.head-cell{padding:10px 9px;font-size:14px;font-weight:700;text-align:center;border-right:1px solid rgba(255,255,255,.16)}.head-cell.product{text-align:left;padding-left:15px}"
				& ".matrix-body{height:calc(100% - 78px);overflow:auto}.matrix-row:nth-child(even){background:#FCF7F0}"
				& ".product-cell,.data-cell{min-height:54px;padding:8px 10px;border-right:1px solid #EDE8E1;border-bottom:1px solid #EDE8E1}"
				& ".product-cell{display:flex;align-items:center;text-align:left;padding-left:15px}.product-cell strong{display:block;font-size:14px;font-weight:700}.product-cell span{display:none}"
				& ".data-cell{text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px}.money{font-size:13px;font-weight:700;white-space:nowrap}.share{font-size:10px;color:#6E5746;white-space:nowrap}"
				& ".total-cell{background:#F2ECE5}.grand-row{position:sticky;bottom:0;background:#EDE8E1;font-weight:700}.grand-cell{background:#EDE8E1}.grand-label{display:flex;align-items:center;padding-left:15px;text-align:left;border-right:1px solid #D9D0C7}"
				& "</style>"
				& "<section class='matrix-shell'><div class='matrix-title'><h2>Vendas por Produto e Região</h2><p>% = participação da região no total de vendas do produto</p></div>"
				& "<div class='matrix-header'><div class='head-cell product'>Produto</div>" & CabecalhoRegioes & "<div class='head-cell total'>Total</div></div>"
				& "<div class='matrix-body'>" & LinhasProdutos
				& "<div class='matrix-row grand-row' style='grid-template-columns:" & ColunasGrid & ";'><div class='grand-label'>Total geral</div>"
				& TotaisRegiao & "<div class='data-cell grand-cell'><span class='money'>" & FORMAT(TotalGeral, "R$ #,##0") & "</span><span class='share'>100.0%</span></div></div>"
				& "</div></section>"
		displayFolder: Participação
		lineageTag: 1e56a984-6f54-4c42-a93a-2f15a55fdd31

	/// Mantem as combinacoes no dataset do Deneb quando o atingimento esta vazio.
	measure 'Linha Farol' = 1
		formatString: 0
		displayFolder: Metas
		lineageTag: 4ec3e8e0-8f38-4f92-b0ea-9ed0fac2715f

	measure 'Vendas Metas Oficiais' =
			VAR ChavesOficiais =
				CALCULATETABLE(
					VALUES(dMetas[CHAVE_META]),
					REMOVEFILTERS(fVendas)
				)
			RETURN
				CALCULATE(
					[Total Vendas],
					REMOVEFILTERS(dMetas),
					TREATAS(ChavesOficiais, fVendas[CHAVE_META])
				)
		formatString: R$ #,##0
		displayFolder: Metas
		lineageTag: b64ddf0b-ff43-4f52-b531-dc07ad9d94d4

	measure 'Valor Metas Ciclos' =
			VAR QtdAnos = COUNTROWS(VALUES(dCalendario[Ano]))
			VAR MetaBase =
				CALCULATE(
					[Total Meta],
					REMOVEFILTERS(fVendas),
					REMOVEFILTERS(dCalendario)
				)
			RETURN MetaBase * QtdAnos
		formatString: R$ #,##0
		displayFolder: Metas
		lineageTag: 8fa2559f-d080-4d76-a302-eb9b244b2dd7

	measure '% Execução Metas Oficiais' = DIVIDE([Vendas Metas Oficiais], [Valor Metas Ciclos])
		formatString: 0.0%
		displayFolder: Metas
		lineageTag: 8ad7bcc6-f982-4cf4-bd93-a68292525aef

	measure 'Combinações Meta com Venda' =
			VAR ChavesOficiais =
				CALCULATETABLE(
					VALUES(dMetas[CHAVE_META]),
					REMOVEFILTERS(fVendas),
					REMOVEFILTERS(dCalendario)
				)
			RETURN
				COUNTROWS(
					FILTER(
						ChavesOficiais,
						VAR ChaveAtual = dMetas[CHAVE_META]
						VAR VendasChave =
							CALCULATE(
								[Total Vendas],
								REMOVEFILTERS(dMetas),
								TREATAS({ ChaveAtual }, fVendas[CHAVE_META])
							)
						RETURN VendasChave > 0
					)
				)
		formatString: 0
		displayFolder: Metas
		lineageTag: 8d5dfd3f-6250-4bad-967a-4cb82d432ebb

	measure 'HTML Controle Metas' =
			VAR AnosSelecionados = VALUES(dCalendario[Ano])
			VAR QtdAnos = COUNTROWS(AnosSelecionados)
			VAR RegioesOperacao =
				CALCULATETABLE(
					DISTINCT(fVendas[REGIÃO]),
					REMOVEFILTERS(fVendas),
					REMOVEFILTERS(dMetas),
					REMOVEFILTERS(dCalendario)
				)
			VAR ProdutosOperacao =
				CALCULATETABLE(
					DISTINCT(fVendas[ID_PRODUTO]),
					REMOVEFILTERS(fVendas),
					REMOVEFILTERS(dMetas),
					REMOVEFILTERS(dCalendario)
				)
			VAR MetasBase =
				CALCULATETABLE(
					SUMMARIZE(
						dMetas,
						dMetas[CHAVE_META],
						dMetas[PRODUTO_ID],
						dMetas[REGIÃO],
						dMetas[TRIMESTRE],
						dMetas[META_VENDAS]
					),
					REMOVEFILTERS(fVendas),
					REMOVEFILTERS(dCalendario)
				)
			VAR TotalRegioes = COUNTROWS(RegioesOperacao)
			VAR RegioesComMeta =
				COUNTROWS(
					FILTER(
						RegioesOperacao,
						VAR RegiaoAtual = fVendas[REGIÃO]
						RETURN
							COUNTROWS(
								FILTER(MetasBase, dMetas[REGIÃO] = RegiaoAtual)
							) > 0
					)
				)
			VAR TotalCombinacoes = TotalRegioes * COUNTROWS(ProdutosOperacao)
			VAR CombinacoesComMeta = COUNTROWS(MetasBase)
			VAR CombinacoesSemMeta = TotalCombinacoes - CombinacoesComMeta
			VAR CoberturaCombinacoes = DIVIDE(CombinacoesComMeta, TotalCombinacoes)
			VAR TextoRegioes =
				RegioesComMeta & " de " & TotalRegioes
				& " regiões possuem meta oficial."
			VAR CartoesRegiao =
				CONCATENATEX(
					RegioesOperacao,
					VAR Regiao = fVendas[REGIÃO]
					VAR MetasRegiao =
						FILTER(MetasBase, dMetas[REGIÃO] = Regiao)
					VAR QtdMetasRegiao = COUNTROWS(MetasRegiao)
					VAR ChavesRegiao =
						SELECTCOLUMNS(
							MetasRegiao,
							"Chave", dMetas[CHAVE_META]
						)
					VAR MetaCiclos =
						SUMX(MetasRegiao, dMetas[META_VENDAS]) * QtdAnos
					VAR Vendas =
						IF(
							QtdMetasRegiao > 0,
							CALCULATE(
								[Total Vendas],
								REMOVEFILTERS(dMetas),
								TREATAS(ChavesRegiao, fVendas[CHAVE_META]),
								TREATAS(AnosSelecionados, dCalendario[Ano])
							)
						)
					VAR Atingimento = DIVIDE(Vendas, MetaCiclos)
					VAR TemVenda = NOT ISBLANK(Vendas) && Vendas > 0
					VAR TemMeta = QtdMetasRegiao > 0
					VAR Barra = MIN(1, COALESCE(Atingimento, 0))
					VAR Cor =
						SWITCH(
							TRUE(),
							NOT TemMeta, "#928F8B",
							NOT TemVenda, "#B0A9A4",
							Atingimento >= 1, "#4A7C59",
							Atingimento >= 0.7, "#9C7A3C",
							"#7A3C3C"
						)
					VAR Fundo =
						SWITCH(
							TRUE(),
							NOT TemMeta, "#F5F2EF",
							NOT TemVenda, "#F5F2EF",
							Atingimento >= 1, "#EBF0ED",
							Atingimento >= 0.7, "#F8EDD9",
							"#F5E8E8"
						)
					VAR Estado =
						SWITCH(
							TRUE(),
							NOT TemMeta, "Sem meta definida",
							NOT TemVenda, "Sem venda vinculada",
							Atingimento >= 1, "Meta superada",
							Atingimento >= 0.7, "Em atenção",
							"Abaixo da meta"
						)
					VAR Percentual = IF(TemVenda, FORMAT(Atingimento, "0%"), "&mdash;")
					VAR EscopoMeta =
						IF(
							TemMeta,
							CONCATENATEX(
								MetasRegiao,
								"P" & dMetas[PRODUTO_ID] & " &middot; " & dMetas[TRIMESTRE],
								", ",
								dMetas[PRODUTO_ID],
								ASC
							),
							"Nenhuma combinação cadastrada"
						)
					RETURN
						"<article class='region-card'>"
						& "<div class='region-head'><div><small>REGIÃO</small><h3>" & Regiao & "</h3></div>"
						& "<span class='status' style='color:" & Cor & ";background:" & Fundo & ";'>" & Estado & "</span></div>"
						& "<p class='scope'>" & EscopoMeta & "</p>"
						& "<div class='region-result'><strong>" & Percentual & "</strong><span>atingimento</span></div>"
						& "<div class='track'><div class='fill' style='width:" & FORMAT(Barra, "0%") & ";background:" & Cor & ";'></div></div>"
						& "<div class='values'><span>Meta <b>" & IF(TemMeta, FORMAT(MetaCiclos, "R$ #,##0"), "&mdash;") & "</b></span>"
						& "<span>Vendas <b>" & IF(TemVenda, FORMAT(Vendas, "R$ #,##0"), "&mdash;") & "</b></span></div>"
						& "</div>",
					"",
					fVendas[REGIÃO],
					ASC
				)
			RETURN
				"<style>"
				& "*{box-sizing:border-box}#htmlContent,.htmlViewerEntry{width:100%;height:100%;margin:0;padding:0}"
				& ".metas{font-family:'Segoe UI',Arial,sans-serif;color:#24212E;background:#fff;border:1px solid #EDE8E1;border-radius:16px;padding:20px 22px;height:100%;overflow:hidden}"
				& ".head{display:flex;justify-content:space-between;align-items:flex-start;gap:28px;margin-bottom:13px}.head h2{font-size:25px;line-height:1.1;margin:0 0 7px;font-weight:750}.head p{font-size:13px;line-height:1.45;color:#6E5746;margin:0;max-width:1050px}.headline{font-size:13px;font-weight:700;color:#24212E;background:#FCF7F0;border:1px solid #EDE8E1;border-radius:999px;padding:9px 14px;white-space:nowrap}"
				& ".coverage{display:grid;grid-template-columns:180px 200px 1fr 210px;align-items:center;gap:18px;background:#FCF7F0;border:1px solid #EDE8E1;border-radius:12px;padding:12px 15px;margin-bottom:14px}.metric small{display:block;font-size:10px;letter-spacing:.08em;color:#928F8B;margin-bottom:2px}.metric strong{font-size:23px;line-height:1}.metric span{font-size:11px;color:#928F8B;margin-left:4px}.coverage-copy strong{display:block;font-size:13px;margin-bottom:5px}.coverage-copy span{font-size:11px;color:#6E5746}.coverage-track{display:flex;height:11px;border-radius:8px;overflow:hidden;background:#E8DFD4;margin-bottom:5px}.covered{background:#566164}.uncovered{flex:1;background:#C4A68A}.coverage-labels{display:flex;justify-content:space-between;font-size:10px;color:#928F8B}.alert{border-left:3px solid #7A3C3C;padding-left:12px}.alert strong{display:block;font-size:20px;color:#7A3C3C}.alert span{font-size:11px;color:#928F8B}"
				& ".regions{display:grid;grid-template-columns:repeat(5,1fr);gap:11px}.region-card{position:relative;min-width:0;border:1px solid #EDE8E1;border-radius:12px;padding:12px 13px;background:#fff;overflow:hidden}.region-card:before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:#B08D72}.region-head{display:flex;align-items:flex-start;justify-content:space-between;gap:6px}.region-head small{font-size:9px;letter-spacing:.09em;color:#928F8B}.region-head h3{font-size:16px;margin:1px 0 0}.status{font-size:9px;font-weight:700;border-radius:10px;padding:4px 7px;white-space:nowrap}.scope{height:16px;overflow:hidden;font-size:11px;font-weight:600;color:#6E5746;margin:9px 0}.region-result{display:flex;align-items:baseline;gap:6px}.region-result strong{font-size:23px;line-height:1}.region-result span{font-size:10px;color:#928F8B}.track{height:7px;border-radius:5px;background:#F2ECE5;overflow:hidden;margin:9px 0}.fill{height:100%;border-radius:5px}.values{display:flex;justify-content:space-between;gap:8px;font-size:10px;color:#928F8B}.values b{display:block;font-size:11px;color:#24212E;margin-top:2px}"
				& "</style>"
				& "<section class='metas'>"
				& "<div class='head'><div><h2>Meta Regional</h2><p>Esta visão separa cobertura de execução: mostra onde existem metas e, para cada região coberta, compara as vendas vinculadas com a meta recorrente dos " & QtdAnos & " anos selecionados.</p></div><span class='headline'>" & TextoRegioes & "</span></div>"
				& "<div class='coverage'>"
				& "<div class='metric'><small>REGIÕES COM META</small><strong>" & RegioesComMeta & "/" & TotalRegioes & "</strong><span>regiões</span></div>"
				& "<div class='metric'><small>COMBINAÇÕES COBERTAS</small><strong>" & CombinacoesComMeta & "/" & TotalCombinacoes & "</strong><span>" & FORMAT(CoberturaCombinacoes, "0%") & "</span></div>"
				& "<div class='coverage-copy'><strong>Cobertura das combinações produto &times; região</strong><div class='coverage-track'><div class='covered' style='width:" & FORMAT(CoberturaCombinacoes, "0%") & ";'></div><div class='uncovered'></div></div><div class='coverage-labels'><span>Com meta definida</span><span>Sem meta definida</span></div></div>"
				& "<div class='alert'><strong>" & CombinacoesSemMeta & " sem meta</strong><span>combinações produto &times; região ainda não possuem meta oficial</span></div>"
				& "</div><div class='regions'>" & CartoesRegiao & "</div></section>"
		displayFolder: Metas
		lineageTag: 0a7da1bd-f5e9-45dc-87bb-3afce1962fe7

	/// Tabela trimestral de desempenho renderizada pelo visual HTML Content.
	measure 'HTML Tabela Trimestral' =
			VAR Trimestres =
				FILTER(
					CALCULATETABLE(
						VALUES(dCalendario[AnoTri]),
						ALLSELECTED(dCalendario[AnoTri])
					),
					NOT ISBLANK(dCalendario[AnoTri])
				)
			VAR TrimestresDetalhados =
				ADDCOLUMNS(
					Trimestres,
					"@Vendas",    IFERROR(CALCULATE([Total Vendas]),     BLANK()),
					"@VsMedHist", IFERROR(CALCULATE([% vs Média Hist]),  BLANK()),
					"@VarLY",     IFERROR(CALCULATE([% Variação vs LY]), BLANK())
				)
			VAR TotalVendas = IFERROR(CALCULATE([Total Vendas],     ALLSELECTED(dCalendario[AnoTri])), BLANK())
			VAR TotalVsMed  = IFERROR(CALCULATE([% vs Média Hist],  ALLSELECTED(dCalendario[AnoTri])), BLANK())
			VAR TotalVarLY  = IFERROR(CALCULATE([% Variação vs LY], ALLSELECTED(dCalendario[AnoTri])), BLANK())
			VAR Linhas =
				CONCATENATEX(
					TrimestresDetalhados,
					VAR Tri      = dCalendario[AnoTri]
					VAR Vendas   = [@Vendas]
					VAR VsMed    = [@VsMedHist]
					VAR VarLY    = [@VarLY]
					VAR CorMed   = SWITCH(TRUE(), ISBLANK(VsMed), "#928F8B", VsMed >= 1, "#4A7C59", "#7A3C3C")
					VAR FundoMed = SWITCH(TRUE(), ISBLANK(VsMed), "transparent", VsMed >= 1, "#EBF0ED", "#F5E8E8")
					VAR CorVar   = SWITCH(TRUE(), ISBLANK(VarLY), "#928F8B", VarLY >= 0, "#4A7C59", "#7A3C3C")
					VAR FundoVar = SWITCH(TRUE(), ISBLANK(VarLY), "transparent", VarLY >= 0, "#EBF0ED", "#F5E8E8")
					VAR TextoVar = IF(ISBLANK(VarLY), "&mdash;", IF(VarLY >= 0, "+" & FORMAT(VarLY, "0.00%"), FORMAT(VarLY, "0.00%")))
					RETURN
						"<div class='t-row'>"
						& "<div class='c-tri'>" & Tri & "</div>"
						& "<div class='c-num'>" & IF(ISBLANK(Vendas), "&mdash;", FORMAT(Vendas, "R$ #,##0")) & "</div>"
						& "<div class='c-pct' style='color:" & CorMed & ";background:" & FundoMed & ";'>" & IF(ISBLANK(VsMed), "&mdash;", FORMAT(VsMed, "0.00%")) & "</div>"
						& "<div class='c-var' style='color:" & CorVar & ";background:" & FundoVar & ";'>" & TextoVar & "</div>"
						& "</div>",
					"",
					dCalendario[AnoTri],
					ASC
				)
			VAR CorMedTotal   = SWITCH(TRUE(), ISBLANK(TotalVsMed), "#928F8B", TotalVsMed >= 1, "#4A7C59", "#7A3C3C")
			VAR CorVarTotal   = SWITCH(TRUE(), ISBLANK(TotalVarLY), "#928F8B", TotalVarLY >= 0, "#4A7C59", "#7A3C3C")
			VAR TextoVarTotal = IF(ISBLANK(TotalVarLY), "&mdash;", IF(TotalVarLY >= 0, "+" & FORMAT(TotalVarLY, "0.00%"), FORMAT(TotalVarLY, "0.00%")))
			VAR MediaHistBaseline = IF(NOT ISBLANK(TotalVsMed), DIVIDE(TotalVendas, 1 + TotalVsMed), BLANK())
			VAR _Result =
				"<style>"
				& "*{box-sizing:border-box}#htmlContent,.htmlViewerEntry{width:100%;height:100%;margin:0;padding:0;overflow:hidden}"
				& ".shell{height:100%;display:flex;flex-direction:column;background:#fff;border:1px solid #EDE8E1;border-radius:14px;font-family:'Segoe UI',Arial,sans-serif;color:#24212E;overflow:hidden}"
				& ".ttl{display:flex;align-items:baseline;gap:10px;padding:10px 18px 9px;border-bottom:1px solid #EDE8E1;flex-shrink:0}.ttl h2{margin:0;font-size:15px;font-weight:700;line-height:1.1;white-space:nowrap}.ttl p{margin:0;color:#6E5746;font-size:10px}"
				& ".hdr{display:grid;grid-template-columns:1.1fr 1.3fr 1.1fr 1.1fr;background:#566164;color:#fff;flex-shrink:0;position:relative;z-index:10}.hc{padding:8px 10px;font-size:14px;font-weight:700;text-align:center;border-right:1px solid rgba(255,255,255,.16);position:relative;cursor:default}.hc.l{text-align:left}"
				& ".hc-tip{display:none;position:absolute;top:calc(100% + 6px);left:50%;transform:translateX(-50%);background:#24212E;color:#fff;padding:8px 12px;border-radius:8px;white-space:nowrap;font-size:11px;font-weight:400;z-index:100;box-shadow:0 4px 12px rgba(0,0,0,.3);pointer-events:none;line-height:1.5}.hc:hover .hc-tip{display:block}"
				& ".bdy{flex:1;overflow:auto}.t-row{display:grid;grid-template-columns:1.1fr 1.3fr 1.1fr 1.1fr;border-bottom:1px solid #EDE8E1}.t-row:nth-child(even){background:#FCF7F0}"
				& ".c-tri{padding:7px 10px;font-size:13px;font-weight:600;border-right:1px solid #EDE8E1}"
				& ".c-num,.c-pct,.c-var{padding:7px 10px;font-size:13px;text-align:center;border-right:1px solid #EDE8E1}"
				& ".c-var{font-weight:700;border-right:none}"
				& ".tot{display:grid;grid-template-columns:1.1fr 1.3fr 1.1fr 1.1fr;background:#EDE8E1;font-weight:700;flex-shrink:0;border-top:1px solid #D9D0C7}"
				& ".tc,.tn,.tp,.tv{padding:7px 10px;font-size:13px;border-right:1px solid #D9D0C7}.tp,.tn,.tv{text-align:center}.tv{border-right:none;font-weight:700}"
				& "</style>"
				& "<section class='shell'>"
				& "<div class='ttl'><h2>Desempenho Trimestral</h2><p>comparativo com média histórica e ano anterior</p></div>"
				& "<div class='hdr'><div class='hc l'>Trimestre</div><div class='hc'>Total de Vendas</div>"
				& "<div class='hc'>% vs Média Histórica<span class='hc-tip'>Média histórica de vendas: " & IF(ISBLANK(MediaHistBaseline), "&mdash;", FORMAT(MediaHistBaseline, "R$ #,##0")) & "</span></div>"
				& "<div class='hc'>% Variação vs Ano Anterior<span class='hc-tip'>Variação percentual em relação ao mesmo período do ano anterior</span></div></div>"
				& "<div class='bdy'>" & Linhas & "</div>"
				& "<div class='tot'><div class='tc'>Total</div>"
				& "<div class='tn'>" & IF(ISBLANK(TotalVendas), "&mdash;", FORMAT(TotalVendas, "R$ #,##0")) & "</div>"
				& "<div class='tp' style='color:" & CorMedTotal & ";'>" & IF(ISBLANK(TotalVsMed), "&mdash;", FORMAT(TotalVsMed, "0.00%")) & "</div>"
				& "<div class='tv' style='color:" & CorVarTotal & ";'>" & TextoVarTotal & "</div>"
				& "</div></section>"
			RETURN IFERROR(_Result, "<section class='shell' style='font-family:Segoe UI,Arial,sans-serif;height:100%;display:flex;align-items:center;justify-content:center'><p style='color:#6E5746;font-size:14px;margin:0'>Dados indisponíveis para este filtro</p></section>")
		displayFolder: Inteligência de Tempo
		lineageTag: c3a7f2e9-1b4d-4f8c-9e2a-7d6b5f3a4c1e

	column Medida
		isHidden
		lineageTag: 2f4b150e-81eb-4da7-9683-d39c464221d4
		isNameInferred
		sourceColumn: [Medida]

	partition Medidas = calculated
		mode: import
		source = DATATABLE("Medida", STRING, { { "-" } })

